{
  "name": "@mikan-919/oriel",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "oriel": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/harness.js"
  ],
  "scripts": {
    "build": "bun build apps/serve/src/cli.ts --outfile dist/cli.js --target bun --banner '#!/usr/bin/env bun' && bun build apps/harness/src/main.ts --outfile dist/harness.js --target bun --banner '#!/usr/bin/env bun'",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "bun run build && bun test apps/serve apps/harness packages && bun run test:relay",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/relay",
    "test:relay": "node node_modules/vitest/vitest.mjs run --root apps/relay"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "4.20251117.0",
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.14",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.0",
    "wrangler": "4.44.0"
  }
}
