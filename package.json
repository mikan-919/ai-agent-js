{
  "name": "@mikan-919/oriel",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "oriel": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "scripts": {
    "build": "bun build apps/serve/src/cli.ts --outfile dist/cli.js --target bun --banner '#!/usr/bin/env bun'",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "bun run build && bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.14",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
